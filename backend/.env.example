# --- Server ---
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage

# --- AI provider selection ---
# "gemini" (par defaut, gratuit via https://ai.google.dev) ou "claude"
AI_PROVIDER=gemini

# Cle API Gemini globale (Google AI Studio - gratuit) - repli de dev utilise uniquement si
# l'utilisateur connecte n'a pas configure sa propre cle dans la page "Parametres" du frontend
# (cf PUT /auth/me/gemini-key). Optionnelle en production, pratique en local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cle API Anthropic - requise si AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Storage backend ---
# "local" (par defaut, ecrit dans STORAGE_DIR, sert via /files) ou "r2" (Cloudflare R2, gratuit jusqu'a 10 Go)
STORAGE_BACKEND=local

# Requis si STORAGE_BACKEND=r2 (voir README > Deploiement backend)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=archi3d-uploads
R2_PUBLIC_BASE_URL=

# --- Authentification Google OAuth ---
# A creer gratuitement sur https://console.cloud.google.com (APIs & Services > Identifiants >
# Creer des identifiants > ID client OAuth > type "Application Web"). Voir README >
# Authentification pour la procedure complete pas a pas (dev local ET production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit correspondre EXACTEMENT a une "URI de redirection autorisee" du client OAuth cote Google.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# URL du frontend vers laquelle rediriger une fois connecte (ex: URL GitHub Pages en production).
FRONTEND_URL=http://localhost:5173

# Secret de signature des sessions (cookie httpOnly). Generer une valeur aleatoire, ex :
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# NE JAMAIS commiter la vraie valeur ni la reutiliser d'un environnement a l'autre.
SESSION_SECRET=

# "lax" en local (frontend/backend sur localhost, ports differents). En production, le frontend
# (GitHub Pages) et le backend sont sur des domaines differents (cross-site) : mettre "none" et
# passer SESSION_COOKIE_SECURE=true (obligatoire ensemble, sinon le cookie est rejete).
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Cle de chiffrement (Fernet) des secrets utilisateur stockes en base (cle API Gemini
# personnelle). Generer avec :
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NE JAMAIS commiter la vraie valeur. Si elle change, les cles Gemini deja enregistrees par les
# utilisateurs deviennent indechiffrables (ils devront la ressaisir).
SECRETS_ENCRYPTION_KEY=
