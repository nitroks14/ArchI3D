# --- Server ---
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage

# --- AI provider selection ---
# "gemini" (par defaut, gratuit via https://ai.google.dev) ou "claude"
AI_PROVIDER=gemini

# Cle API Gemini (Google AI Studio - gratuit) - requise si AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cle API Anthropic - requise si AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Storage backend ---
# "local" (par defaut, ecrit dans STORAGE_DIR, sert via /files) ou "r2" (Cloudflare R2, gratuit jusqu'a 10 Go)
STORAGE_BACKEND=local

# Requis si STORAGE_BACKEND=r2 (voir README > Deploiement backend)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=archi3d-uploads
R2_PUBLIC_BASE_URL=
